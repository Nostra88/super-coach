    var ms=h.matches.map(function(m,mi){
      var t=getType(m.result);var sc=getSC(m.sport_id);
      var cls='hist-m '+t+(m.verified===true?' ok':m.verified===false?' ko':'');
      return '<span class="'+cls+'" onclick="toggleV('+hi+','+mi+')">'+sc.e+' '+(m.home||'').split(' ')[0]+' '+(m.verified===true?'✓':m.verified===false?'✗':'')+'</span>';
    }).join('');
    return '<div class="hist-item"><div class="hist-item-hdr"><span class="hist-date">📅 '+h.date+'</span><span class="hist-badge '+(h.mode||'pre')+'">'+(h.mode==='live'?'🔴 LIVE':'🔮 PRE')+'</span></div>'+(ms?'<div class="hist-matches">'+ms+'</div>':'')+'</div>';
  }).join('');

  body.innerHTML=roiS+items+'<button class="hist-del-btn" onclick="clearH()">🗑 Effacer l\'historique</button>';
  document.getElementById('histModal').classList.add('open');
}

function toggleV(hi,mi){
  var h=JSON.parse(localStorage.getItem('sc_hist')||'[]');
  if(!h[hi])return;
  var cur=h[hi].matches[mi].verified;
  h[hi].matches[mi].verified=cur===null?true:cur===true?false:null;
  localStorage.setItem('sc_hist',JSON.stringify(h));
  openHistModal();
}
function clearH(){if(confirm('Effacer tout ?')){localStorage.removeItem('sc_hist');openHistModal();}}
function closeModal(e){if(!e||e.target.id==='histModal')document.getElementById('histModal').classList.remove('open');}
function escH(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

window.onerror=function(msg,src,line){
  console.error('ERREUR:',msg,line);
  showOut('<div class="error-box">⚠ Erreur : '+msg+'</div>');
};
</script>
</body>
</html>
