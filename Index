<script>
// ═══ CONFIG ═══
// URL du backend Render — à mettre à jour après déploiement
var BACKEND_URL = 'https://supercoach-api.onrender.com';

var chips = {rotation:true,blesses:true,forme:true,h2h:true,enjeu:true};
var activeTab = 'manual';
var currentMode = 'pre';
var activeSports = ['all'];

var SPORTS = [
  {id:'all',l:'Tous',e:'🌍',c:'#00E676',b:'rgba(0,230,118,.09)'},
  {id:'foot',l:'Football',e:'⚽',c:'#22c55e',b:'rgba(34,197,94,.09)'},
  {id:'basket',l:'Basket',e:'🏀',c:'#f97316',b:'rgba(249,115,22,.09)'},
  {id:'tennis',l:'Tennis',e:'🎾',c:'#eab308',b:'rgba(234,179,8,.09)'},
  {id:'rugby',l:'Rugby',e:'🏉',c:'#84cc16',b:'rgba(132,204,22,.09)'},
  {id:'mma',l:'MMA',e:'🥋',c:'#ef4444',b:'rgba(239,68,68,.09)'},
  {id:'boxe',l:'Boxe',e:'🥊',c:'#dc2626',b:'rgba(220,38,38,.09)'},
  {id:'hockey',l:'Hockey',e:'🏒',c:'#3b82f6',b:'rgba(59,130,246,.09)'},
  {id:'hand',l:'Hand',e:'🤾',c:'#8b5cf6',b:'rgba(139,92,246,.09)'},
  {id:'volley',l:'Volley',e:'🏐',c:'#06b6d4',b:'rgba(6,182,212,.09)'},
  {id:'f1',l:'F1/Moto',e:'🏎️',c:'#f59e0b',b:'rgba(245,158,11,.09)'},
  {id:'base',l:'Baseball',e:'⚾',c:'#10b981',b:'rgba(16,185,129,.09)'}
];

// ═══ INIT ═══
window.onload = function() {
  buildSportGrid();
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').catch(function(){});
  }
};

// ═══ SPORT GRID ═══
function buildSportGrid() {
  var html = '';
  SPORTS.forEach(function(s) {
    var on = s.id === 'all';
    html += '<div class="sport-chip'+(on?' on':'')+'" id="sc-'+s.id+'" onclick="toggleSport(\''+s.id+'\')" style="'+(on?'border-color:'+s.c+';color:'+s.c+';background:'+s.b:'')+'">';
    html += '<div class="sc-icon" style="background:'+s.b+';border:1px solid '+s.c+'33">'+s.e+'</div>';
    html += s.l+'</div>';
  });
  document.getElementById('sportGrid').innerHTML = html;
}

function toggleSport(id) {
  if (id === 'all') { activeSports = ['all']; }
  else {
    var i = activeSports.indexOf('all');
    if (i > -1) activeSports.splice(i, 1);
    i = activeSports.indexOf(id);
    if (i > -1) activeSports.splice(i, 1); else activeSports.push(id);
    if (!activeSports.length) activeSports = ['all'];
  }
  SPORTS.forEach(function(s) {
    var el = document.getElementById('sc-'+s.id);
    var on = activeSports.indexOf(s.id) > -1;
    el.classList.toggle('on', on);
    el.style.borderColor = on ? s.c : '';
