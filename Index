<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SUPERCOACH">
<meta name="theme-color" content="#050608">
<meta name="description" content="SUPERCOACH — L'IA qui analyse. Toi qui gagnes.">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>SUPERCOACH</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;600;700&family=Syne:wght@400;600;700;800&display=swap');

:root {
  --bg:#050608;
  --s1:#0a0f0a;
  --s2:#0f1a0f;
  --s3:#152015;
  --b1:#1a2a1a;
  --b2:#243324;
  --vert:#00E676;
  --vert2:#00A152;
  --vd:rgba(0,230,118,.1);
  --vd2:rgba(0,230,118,.05);
  --rouge:#FF2D55;
  --rd:rgba(255,45,85,.08);
  --gris:#64748b;
  --or:#FFB800;
  --od:rgba(255,184,0,.08);
  --violet:#8b5cf6;
  --text:#c8e6c9;
  --text2:#e8f5e9;
  --white:#f1fff3;
  --dim:#4a7a4a;
}

*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;height:100%}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Syne',sans-serif;
  min-height:100vh;
  min-height:-webkit-fill-available;
  overflow-x:hidden;
  padding-bottom:env(safe-area-inset-bottom);
}

::-webkit-scrollbar{width:2px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--b2);border-radius:2px}

@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.7)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideIn{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:translateX(0)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes glowPulse{0%,100%{box-shadow:0 0 10px rgba(0,230,118,.2)}50%{box-shadow:0 0 25px rgba(0,230,118,.5)}}
@keyframes lightning{0%,100%{opacity:0}5%,95%{opacity:1}}

/* ── HEADER ── */
.hdr{
  background:rgba(5,6,8,.95);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(0,230,118,.15);
  padding:12px 16px;
  padding-top:calc(12px + env(safe-area-inset-top));
  display:flex;align-items:center;justify-content:space-between;
  position:sticky;top:0;z-index:200;
}
.hdr::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--vert),transparent);
  opacity:.4;
}
.hdr-left{display:flex;align-items:center;gap:10px}
.hdr-logo{
  width:36px;height:36px;
  display:flex;align-items:center;justify-content:center;
}
.hdr-logo svg{width:36px;height:36px}
.hdr-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:20px;letter-spacing:4px;color:var(--white);
}
.hdr-title span{color:var(--vert)}
.hdr-right{display:flex;align-items:center;gap:7px}
.live-ind{
  display:flex;align-items:center;gap:4px;
  font-family:'JetBrains Mono',monospace;font-size:8px;
  color:var(--rouge);letter-spacing:2px;
  background:rgba(255,45,85,.08);border:1px solid rgba(255,45,85,.2);
  padding:3px 8px;border-radius:10px;
}
.live-dot{width:5px;height:5px;background:var(--rouge);border-radius:50%;animation:blink 1s infinite}
.hbtn{
  padding:5px 11px;background:transparent;
  border:1px solid var(--b2);border-radius:12px;
  color:var(--dim);font-family:'JetBrains Mono',monospace;
  font-size:8px;letter-spacing:1px;cursor:pointer;text-transform:uppercase;
}

/* ── MAIN ── */
.main{max-width:820px;margin:0 auto;padding:16px 12px 100px}

/* ── HERO ── */
.hero{text-align:center;padding:24px 8px 18px;animation:fadeUp .6s ease both}
.hero-logo{
  width:90px;height:90px;margin:0 auto 14px;
  filter:drop-shadow(0 0 20px rgba(0,230,118,.4));
}
.hero h1{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(42px,10vw,72px);
  letter-spacing:6px;color:var(--white);line-height:.9;margin-bottom:6px;
}
.hero h1 span{
  color:var(--vert);
  text-shadow:0 0 30px rgba(0,230,118,.4),0 0 60px rgba(0,230,118,.2);
}
.hero-tag{
  font-family:'JetBrains Mono',monospace;font-size:10px;
  color:var(--vert2);letter-spacing:2px;margin-bottom:16px;
  display:block;
}
.legend{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:4px}
.leg{display:flex;align-items:center;gap:5px;font-size:9px;font-weight:700;
  letter-spacing:1px;text-transform:uppercase;font-family:'JetBrains Mono',monospace}
.ldot{width:8px;height:8px;border-radius:50%}

/* ── MODE SELECTOR ── */
.mode-selector{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.mode-btn{
  padding:14px 8px;background:var(--s1);
  border:1px solid var(--b1);border-radius:12px;
  cursor:pointer;text-align:center;user-select:none;
  position:relative;transition:all .2s;overflow:hidden;
}
.mode-btn::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(0,230,118,.05),transparent);
  opacity:0;transition:opacity .2s;
}
.mode-btn.on{border-color:rgba(0,230,118,.4);background:var(--vd)}
.mode-btn.on::before{opacity:1}
.mode-btn .mb-icon{font-size:22px;margin-bottom:5px}
.mode-btn .mb-title{
  font-family:'Bebas Neue',sans-serif;font-size:14px;
  letter-spacing:2px;color:var(--white);margin-bottom:2px;
}
.mode-btn.on .mb-title{color:var(--vert)}
.mode-btn .mb-sub{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--dim)}
.mb-badge{
  position:absolute;top:8px;right:8px;
  font-family:'JetBrains Mono',monospace;font-size:7px;
  padding:2px 6px;border-radius:8px;letter-spacing:1px;font-weight:700;
}
.mb-free{background:rgba(0,230,118,.12);color:var(--vert);border:1px solid rgba(0,230,118,.25)}
.mb-live{background:rgba(255,45,85,.12);color:var(--rouge);border:1px solid rgba(255,45,85,.25);animation:blink 2s infinite}

/* ── CARD ── */
.card{
  background:var(--s1);border:1px solid var(--b1);
  border-radius:12px;overflow:hidden;margin-bottom:12px;
  position:relative;
}
.card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(0,230,118,.2),transparent);
}
.card.a1{animation:fadeUp .5s ease both}
.card.a2{animation:fadeUp .5s .07s ease both}
.card-hdr{
  background:var(--s2);border-bottom:1px solid var(--b1);
  padding:10px 14px;display:flex;align-items:center;justify-content:space-between;
}
.card-label{
  font-family:'JetBrains Mono',monospace;font-size:8px;
  letter-spacing:2px;color:var(--or);text-transform:uppercase;
}
.card-body{padding:14px}

/* ── SPORT FILTER ── */
.sf-label{
  font-family:'JetBrains Mono',monospace;font-size:8px;
  color:var(--or);letter-spacing:2px;text-transform:uppercase;
  margin-bottom:8px;display:block;
}
.sport-grid{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.sport-chip{
  display:flex;align-items:center;gap:4px;padding:5px 8px;
  border:1px solid var(--b2);border-radius:14px;
  cursor:pointer;transition:all .18s;user-select:none;
  font-family:'JetBrains Mono',monospace;font-size:8px;
  font-weight:600;color:var(--dim);
}
.sport-chip.on{border-width:1.5px}
.sc-icon{
  width:20px;height:20px;border-radius:5px;
  display:flex;align-items:center;justify-content:center;
  font-size:10px;flex-shrink:0;
}

/* ── TABS ── */
.tabs{display:flex;gap:5px;margin-bottom:11px}
.tab{
  flex:1;padding:8px 4px;background:transparent;
  border:1px solid var(--b2);border-radius:7px;cursor:pointer;
  color:var(--dim);font-family:'JetBrains Mono',monospace;
  font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  display:flex;align-items:center;justify-content:center;gap:3px;
}
.tab.on{background:var(--vd);border-color:rgba(0,230,118,.3);color:var(--vert)}
.panel{display:none}.panel.on{display:block}

/* ── INPUTS ── */
textarea,input[type=text]{
  width:100%;background:var(--s3);border:1px solid var(--b2);
  border-radius:7px;color:var(--text2);
  font-family:'JetBrains Mono',monospace;font-size:11px;
  padding:11px;outline:none;line-height:1.8;-webkit-appearance:none;
}
textarea{resize:vertical;min-height:130px}
textarea:focus,input[type=text]:focus{border-color:rgba(0,230,118,.4)}
textarea::placeholder,input[type=text]::placeholder{color:var(--dim)}

/* PASTE */
.paste-info{
  background:var(--s3);border:1px solid var(--b2);border-radius:7px;
  padding:11px;margin-bottom:9px;
  font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--dim);line-height:2;
}
.paste-info .ti{color:var(--or);font-weight:700;margin-bottom:2px}
.paste-info .gr{color:var(--vert)}.paste-info .hi{color:var(--white)}
.pbtn{
  width:100%;padding:9px;
  background:rgba(0,230,118,.08);border:1px solid rgba(0,230,118,.2);
  border-radius:7px;color:var(--vert);
  font-family:'JetBrains Mono',monospace;font-size:8px;font-weight:700;
  letter-spacing:1px;cursor:pointer;margin-bottom:9px;
  display:flex;align-items:center;justify-content:center;gap:6px;
  text-transform:uppercase;-webkit-appearance:none;
}
.pmsg{font-family:'JetBrains Mono',monospace;font-size:8px;margin-bottom:7px;padding:5px 9px;border-radius:4px;display:none}
.pmsg.ok{color:var(--vert);background:var(--vd);border:1px solid rgba(0,230,118,.2);display:block}
.pmsg.warn{color:var(--or);background:var(--od);border:1px solid rgba(255,184,0,.2);display:block}

/* OPTIONS */
.opts{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}
.chip{
  display:inline-flex;align-items:center;gap:3px;padding:5px 9px;
  border:1px solid var(--b2);border-radius:14px;cursor:pointer;
  font-size:9px;color:var(--dim);background:transparent;
  user-select:none;font-family:'JetBrains Mono',monospace;
}
.chip.on{border-color:rgba(0,230,118,.35);color:var(--vert);background:var(--vd);font-weight:600}

.vb-row{display:flex;gap:6px;margin-top:9px;align-items:center;flex-wrap:wrap}
.vb-label{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:1px;white-space:nowrap}
.vb-in{
  width:80px;background:var(--s3);border:1px solid var(--b2);
  border-radius:6px;color:var(--text2);font-family:'JetBrains Mono',monospace;
  font-size:11px;padding:7px 9px;outline:none;-webkit-appearance:none;flex-shrink:0;
}
.vb-in:focus{border-color:rgba(255,184,0,.4)}

/* ── GO BTN ── */
.go-btn{
  width:100%;margin-top:12px;padding:16px;border:none;border-radius:9px;
  color:#000;font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:5px;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;
  background:linear-gradient(135deg,var(--vert),var(--vert2));
  box-shadow:0 4px 24px rgba(0,230,118,.25);
  -webkit-appearance:none;position:relative;overflow:hidden;
  animation:glowPulse 3s ease infinite;
}
.go-btn:disabled{
  opacity:.4;cursor:not-allowed;animation:none;
  background:var(--s3);color:var(--vert);
  border:1px solid rgba(0,230,118,.2);box-shadow:none;
}
.spinner{
  width:16px;height:16px;border:2px solid rgba(0,0,0,.2);
  border-top-color:#000;border-radius:50%;animation:spin .7s linear infinite;
}

/* LIVE BTN */
.live-btn{
  width:100%;margin-top:12px;padding:16px;
  background:linear-gradient(135deg,var(--rouge),#cc1133);
  border:none;border-radius:9px;color:#fff;
  font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:4px;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
  -webkit-appearance:none;
}
.live-btn:disabled{opacity:.4;cursor:not-allowed}

/* LIVE SCORE */
.lsi{
  background:rgba(255,45,85,.04);border:1px solid rgba(255,45,85,.15);
  border-radius:9px;padding:13px;margin-bottom:11px;
}
.lsi-title{
  font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--rouge);
  letter-spacing:2px;text-transform:uppercase;margin-bottom:9px;
  display:flex;align-items:center;gap:5px;
}
.lsi-row{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;margin-bottom:9px}
.team-in{
  background:var(--bg);border:1px solid var(--b2);border-radius:6px;
  color:var(--white);font-family:'Syne',sans-serif;font-size:11px;font-weight:700;
  padding:7px 8px;outline:none;width:100%;-webkit-appearance:none;
}
.score-wrap{display:flex;align-items:center;justify-content:center;gap:5px}
.score-num{
  width:38px;height:38px;background:var(--bg);border:1px solid var(--b2);
  border-radius:7px;color:var(--white);font-family:'Bebas Neue',sans-serif;
  font-size:22px;text-align:center;outline:none;-webkit-appearance:none;
}
.score-sep{font-family:'Bebas Neue',sans-serif;font-size:18px;color:var(--dim)}
.lsi-meta{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.lsi-field label{
  font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--dim);
  letter-spacing:1px;display:block;margin-bottom:3px;text-transform:uppercase;
}
.lsi-field input{
  background:var(--bg);border:1px solid var(--b2);border-radius:5px;
  color:var(--text2);font-family:'JetBrains Mono',monospace;font-size:10px;
  padding:6px 8px;outline:none;width:100%;-webkit-appearance:none;
}

/* ── THINKING ── */
.thinking{
  background:var(--s1);border:1px solid var(--b1);border-radius:12px;
  padding:36px 18px;text-align:center;animation:fadeUp .3s ease both;margin-bottom:12px;
}
.thinking-emoji{font-size:40px;margin-bottom:12px;animation:pulse 1.5s ease infinite}
.thinking-title{
  font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;
  color:var(--white);margin-bottom:4px;
}
.thinking-sub{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  color:var(--vert2);letter-spacing:2px;margin-bottom:14px;
}
.tsteps{display:inline-flex;flex-direction:column;gap:5px;text-align:left}
.tstep{
  font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--dim);
  display:flex;align-items:center;gap:7px;padding:5px 10px;
  border-radius:5px;background:var(--s2);border:1px solid var(--b1);
}
.tstep.active{color:var(--vert);border-color:rgba(0,230,118,.2);background:var(--vd)}

/* ── ERROR / FALLBACK ── */
.error-box{
  background:var(--rd);border:1px solid rgba(255,45,85,.25);border-radius:10px;
  padding:14px 16px;font-family:'JetBrains Mono',monospace;font-size:10px;
  color:var(--rouge);line-height:1.8;animation:fadeUp .3s ease both;
  margin-bottom:12px;white-space:pre-wrap;word-break:break-word;
}
.fb-box{
  background:var(--s1);border:1px solid var(--b1);border-radius:10px;
  padding:14px;font-family:'JetBrains Mono',monospace;font-size:10px;
  color:var(--text);line-height:1.9;white-space:pre-wrap;
  word-break:break-word;animation:fadeUp .4s ease both;margin-bottom:12px;
}

/* ── RESULTS ── */
.results{animation:fadeUp .5s ease both}
.res-hdr{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:13px;padding-bottom:11px;
  border-bottom:1px solid rgba(0,230,118,.1);
}
.res-hdr h2{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:3px;color:var(--white)}
.res-meta{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--dim);text-align:right;line-height:1.7}

/* ROI BANNER */
.roi-banner{
  background:rgba(0,230,118,.06);border:1px solid rgba(0,230,118,.18);
  border-radius:9px;padding:10px 13px;margin-bottom:12px;
  display:flex;align-items:center;gap:9px;flex-wrap:wrap;
}
.roi-text{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--vert2);line-height:1.7;flex:1}
.roi-text b{color:var(--white)}

/* STATS */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:13px}
.stat{
  background:var(--s1);border:1px solid var(--b1);border-radius:8px;
  padding:11px 6px;text-align:center;
}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:28px;line-height:1;margin-bottom:2px}
.stat-lbl{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:2px;color:var(--dim);text-transform:uppercase}

/* MATCH CARD */
.mcard{
  background:var(--s1);border:1px solid var(--b1);border-radius:10px;
  margin-bottom:8px;overflow:hidden;animation:slideIn .32s ease both;
}
.mcard.win{border-left:3px solid var(--vert)}
.mcard.loss{border-left:3px solid var(--rouge)}
.mcard.draw{border-left:3px solid var(--gris)}
.mtop{padding:12px 13px 5px;display:flex;align-items:center;gap:9px}
.mrank{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--b2);min-width:24px;line-height:1}
.mpast{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.mpast.win{background:var(--vert);box-shadow:0 0 10px rgba(0,230,118,.5)}
.mpast.loss{background:var(--rouge);box-shadow:0 0 10px rgba(255,45,85,.5)}
.mpast.draw{background:var(--gris)}
.msport-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.minfo{flex:1;min-width:0}
.mteams{display:flex;align-items:center;gap:5px;margin-bottom:4px;flex-wrap:wrap}
.mteam{display:flex;align-items:center;gap:2px;font-size:13px;font-weight:700;color:var(--white)}
.mteam .loc{font-size:9px;opacity:.4}
.mteam-sep{color:var(--b2);font-size:10px;font-family:'JetBrains Mono',monospace}
.rot-badge{
  background:var(--od);border:1px solid rgba(255,184,0,.25);color:var(--or);
  font-family:'JetBrains Mono',monospace;font-size:7px;padding:1px 5px;
  border-radius:3px;letter-spacing:1px;font-weight:700;flex-shrink:0;
}
.mmeta{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.mcomp{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--dim)}
.mprono{font-family:'JetBrains Mono',monospace;font-size:8px;font-weight:700;letter-spacing:1px;padding:2px 6px;border-radius:3px}
.mprono.win{background:var(--vd);color:var(--vert)}
.mprono.loss{background:var(--rd);color:var(--rouge)}
.mprono.draw{background:rgba(100,116,139,.08);color:var(--gris)}
.mdate{
  display:inline-flex;align-items:center;gap:2px;background:var(--od);
  border:1px solid rgba(255,184,0,.18);color:var(--or);
  font-family:'JetBrains Mono',monospace;font-size:7px;padding:1px 5px;
  border-radius:3px;font-weight:700;
}
.mconf{text-align:right;flex-shrink:0}
.mconf-val{font-family:'Bebas Neue',sans-serif;font-size:20px;line-height:1}
.mconf-val.win{color:var(--vert)}.mconf-val.loss{color:var(--rouge)}.mconf-val.draw{color:var(--gris)}
.mconf-lbl{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--dim);letter-spacing:1px;margin-top:1px}
.mbar{padding:5px 13px 5px 42px}
.mbar-bg{height:3px;background:var(--b2);border-radius:2px;overflow:hidden}
.mbar-fill{height:100%;border-radius:2px}
.mbar-fill.win{background:linear-gradient(90deg,var(--vert),var(--vert2))}
.mbar-fill.loss{background:linear-gradient(90deg,var(--rouge),#cc1133)}
.mbar-fill.draw{background:var(--gris)}
.vb-badge{margin:0 13px 6px 42px;padding:5px 9px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:9px;line-height:1.5}
.vb-badge.strong{background:rgba(139,92,246,.09);border:1px solid rgba(139,92,246,.22);color:#c4b5fd}
