// ═══ PARSER ═══
function robustParse(raw) {
  function tryP(s) { try { return JSON.parse(s); } catch(e) { return null; } }
  var p;
  p = tryP(raw); if (p && (p.matches||p.live_analysis)) return p;
  var c = raw.replace(/```json\s*/gi,'').replace(/```\s*/g,'').trim();
  p = tryP(c); if (p && (p.matches||p.live_analysis)) return p;
  var m = c.match(/\{[\s\S]*\}/);
  if (m) { p = tryP(m[0]); if (p && (p.matches||p.live_analysis)) return p; }
  if (m) { p = tryP(m[0].replace(/,\s*([}\]])/g,'$1')); if (p && (p.matches||p.live_analysis)) return p; }
  return null;
}

function normMatches(arr) {
  return arr.map(function(m,i) {
    return {
      rank:m.rank||i+1, sport:m.sport||'Sport', sport_id:m.sport_id||'other',
      home:m.home||'?', away:m.away||'?', competition:m.competition||'',
      match_date:m.match_date||null, match_time:m.match_time||null,
      result:['WIN_HOME','WIN_AWAY','DRAW'].indexOf(m.result)>-1?m.result:'WIN_HOME',
      confidence:Math.min(Math.max(Number(m.confidence)||65,50),99),
      value_edge_pct:Number(m.value_edge_pct)||null,
      value:m.value||null, value_text:m.value_text||'',
      mise_unites:Math.min(Math.max(Number(m.mise_unites)||2,0),5),
      rotation_alert:!!m.rotation_alert, rotation_text:m.rotation_text||'',
      justification:m.justification||''
    };
  });
}

// ═══ ANALYZE ═══
function analyze() {
  var isPage = activeTab === 'paste';
  var content = isPage ?
    document.getElementById('pasteInput').value.trim() :
    document.getElementById('manualInput').value.trim();
  if (!content) { showOut('<div class="error-box">❌ Colle tes matchs dans la zone LISTE.</div>'); return; }

  var btn = document.getElementById('goBtn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div> SUPERCOACH ANALYSE...';
  showOut(thinkingB(false));

  callBackend(buildPrompt(content, isPage)).then(function(raw) {
    var parsed = robustParse(raw);
    if (parsed && parsed.matches) {
      parsed.matches = normMatches(parsed.matches);
      saveHist(parsed, 'pre');
      showOut(resultsB(parsed));
    } else {
      showOut('<div class="fb-box">'+escH(raw)+'</div><button class="reset-btn" onclick="resetOut()">↺ NOUVELLE ANALYSE</button>');
    }
  }).catch(function(e) {
    showOut('<div class="error-box">❌ '+escH(e.message)+'</div>');
  }).finally(function() {
    btn.disabled = false;
    btn.innerHTML = '⚡ ANALYSER';
  });
}

